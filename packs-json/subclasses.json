[{"name":"勇士 Champion","type":"subclass","img":"icons/skills/social/diplomacy-peace-alliance.webp","system":{"description":{"value":"<p>勇士范型追求在肉体力量上登峰造极。选择此范型的人将战斗训练与强身健体相结合，令自己的攻击无坚不摧。</p>","chat":""},"source":{"custom":"","book":"","page":"","license":"CC-BY-4.0","rules":"2014"},"identifier":"champion","classIdentifier":"fighter","advancement":[{"_id":"bsdg4f5me0klskxn","type":"ItemGrant","configuration":{"items":[{"uuid":"Compendium.dnd5e.classfeatures.YgLQV1O849wE5TgM","optional":false}],"optional":false,"spell":{"ability":[],"preparation":"","uses":{"max":"","per":""}}},"value":{},"level":3,"title":"子职业特性"},{"_id":"22ktkhqczogk0jcg","type":"ItemGrant","configuration":{"items":[{"uuid":"Compendium.dnd5e.classfeatures.dHu1yzIjD38BvGGd","optional":false}],"optional":false,"spell":{"ability":[],"preparation":"","uses":{"max":"","per":""}}},"value":{},"level":7,"title":"子职业特性"},{"_id":"r84l4q20d5aduwlw","type":"ItemGrant","configuration":{"items":[{"uuid":"Compendium.dnd5e.classfeatures.kYJsED0rqqqUcgKz","optional":false}],"optional":false,"spell":{"ability":[],"preparation":"","uses":{"max":"","per":""}}},"value":{},"level":10,"title":"子职业特性"},{"_id":"p4pxgvxtf206xc35","type":"ItemGrant","configuration":{"items":[{"uuid":"Compendium.dnd5e.classfeatures.aVKH6TLn1AG9hPSA","optional":false}],"optional":false,"spell":{"ability":[],"preparation":"","uses":{"max":"","per":""}}},"value":{},"level":15,"title":"子职业特性"},{"_id":"y6rlhwedv35dcrsq","type":"ItemGrant","configuration":{"items":[{"uuid":"Compendium.dnd5e.classfeatures.ipG5yx1tRNmeJfSH","optional":false}],"optional":false,"spell":{"ability":[],"preparation":"","uses":{"max":"","per":""}}},"value":{},"level":18,"title":"子职业特性"},{"_id":"DDqfOiw4IQMv4bAi","type":"ItemChoice","configuration":{"choices":{"10":{"count":1,"replacement":false}},"allowDrops":true,"type":"feat","pool":[{"uuid":"Compendium.dnd5e.classfeatures.8YwPFv3UAPjWVDNf"},{"uuid":"Compendium.dnd5e.classfeatures.zSlV0O2rQMdoq6pB"},{"uuid":"Compendium.dnd