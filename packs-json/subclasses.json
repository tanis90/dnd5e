ymkf4814h8s","type":"ItemGrant","configuration":{"items":[{"uuid":"Compendium.dnd5e.classfeatures.3FB25qKxmkmxcxuC","optional":false}],"optional":false,"spell":{"ability":[],"preparation":"","uses":{"max":"","per":""}}},"value":{},"level":6,"title":"子职业特性"},{"_id":"vxmvdslbnlhreo62","type":"ItemGrant","configuration":{"items":[{"uuid":"Compendium.dnd5e.classfeatures.OTvrJSJSUgAwXrWX","optional":false}],"optional":false,"spell":{"ability":[],"preparation":"","uses":{"max":"","per":""}}},"value":{},"level":10,"title":"子职业特性"},{"_id":"ti7txllqo5o344af","type":"ItemGrant","configuration":{"items":[{"uuid":"Compendium.dnd5e.classfeatures.EuX1kJNIw1F68yus","optional":false}],"optional":false,"spell":{"ability":[],"preparation":"","uses":{"max":"","per":""}}},"value":{},"level":14,"title":"子职业特性"}],"spellcasting":{"progression":"none","ability":"","preparation":{}}},"effects":[],"folder":"lxQ0CSa4jrl17HgP","sort":0,"ownership":{"default":0},"flags":{"mtzh":{"s":"zzzz","m":"id"}},"_id":"4Ae2SPZRXEVbVs0M","_stats":{"duplicateSource":null,"coreVersion":"13.344","systemId":"dnd5e","systemVersion":"4.0.0","createdTime":1725037372807,"modifiedTime":1725992730564,"lastModifiedBy":"dnd5ebuilder0000","exportSource":null}},{"name":"逸闻学院 College of Lore","type":"subclass","img":"icons/sundries/books/book-open-brown-black.webp","system":{"description":{"value":"<p>逸闻学院的诗人们无所不知。他们从日常点滴中搜集信息，从名家古墓到乡野传言无孔不入。无论是小酒馆的歌唱家还是大宫廷里的大作家，都会运用自己诗人的天赋来聚集更多的听众。掌声响毕后，聚拢的听众将会发现相互之间最真实的一面：忠贞的信徒向牧师坦诚自己的信仰；仁义的民众也向国王表达内心的忠诚。</p><p>诗人们只忠于其追求的真与美，而不向任何君王或神奉承尽忠。那些供养吟游诗人的贵族基本都理解他们的使者或顾问更趋向于诚实而非利益。</p><p>该学院的成员会在图书馆甚至大学院校里搜集知识，与会友交流分享所见所闻。在节日或公众事件期间他们也会见面，然后痛快的畅所欲言。他们通常喜欢揭发腐败与谎言，并嘲弄那些高高在上的要人与权威。</p>","chat":""},"source":{"custom":"","book":"","page":"","license":"CC-BY-4.0","rules":"2014"},"identifier":"college-of-lore","classIdentifier":"bard","advancement":[{"_id":"GgjL1Z4CKIkVLcyz","type":"Trait","configuration":{"mode":"default","allowReplacements":false,"grants":[],"choices":[{"count":3,"pool":["skills:*"]}]},"level":3,"title":"","value":{"chosen":[]}},{"_id":"pxolz5oyrvbez6aj","type":"ItemGrant","level":3,"title":"子职业特性","configuration":{"items":[{"uuid":"Compendium.dnd5e.classfeatures.e9ytGikyLFgwZ5wi","optional":false},{"uuid":"Compendium.dnd5e.classfeatures.5zPmHPQUne7RDfaU","optional":false}],"optional":false,"spell":{"ability":[],"preparation":"","uses":{"max":"","per":""}}},"value":{}},{"_id":"pfjv7s5yjgoi3i1w","type":"ItemGrant","configuration":{"items":[{"uuid":"Compendium.dnd5e.classfeatures.myBu3zi5eYvQIcuy","optional":false}],"optional":false,"spell":{"ability":[],"preparation":"","uses":{"max":"","per":""}}},"value":{},"level":6,"title":"子职业特性"},{"_id":"6seg1bfvuexp0gh9","type":"ItemGrant","level":14,"title":"子职业特性","configuration":{"items":[{"uuid":"Compendium.dnd5e.classfeatures.pquwueEMweRhiWaq","optional":false}],"optional":false,"spell":{"ability":[],"preparation":"","uses":{"max":"","per":""}}},"value":{}},{"_id":"zmBtra2UDx5BYyR7","type":"ItemChoice","configuration":{"choices":{"6":{"count":2,"replacement":false}},"allowDrops":true,"type":"spell","pool":[],"spell":{"ability":[],"preparation":"","uses":{"max":"","per":""}},"restriction":{"type":"","subtype":"","level":"available"}},"value":{"added":{},"replaced":{}},"title":"额外魔法奥秘","hint":"Learn two spells of your choice from any class. A spell you choose must be of a level you can cast, as shown on the Bard table, or a cantrip."}],"spellcasting":{"progression":"none","ability":"","preparation":{}}},"effects":[],"folder":"T6msdzH93deRLFQg","sort":0,"ownership":{"default":0},"flags":{"mtzh":{"s":"zzzz","m":"id"}},"_id":"MNvsEc4D2ccX7dQT","_stats":{"duplicateSource":null,"coreVersion":"13.344","systemId":"dnd5e","systemVersion":"4.0.0","createdTime":1725037372893,"modifiedTime":1725992730613,"lastModifiedBy":"dnd5ebuilder0000","exportSource":null}},{"name":"龙族血脉 Draconic Bloodline","type":"subclass","img":"icons/creatures/reptiles/dragon-horned-blue.webp","system":{"description":{"value":"<p>你的天赋魔法源于龙族的魔力，其本质混杂在你的血液或是祖辈传承下来的血统当中。具有该起源的术士通常都可以将其血脉追溯至远古时代曾与巨龙定下契约的某位强大术士，或者甚至是某位巨龙的血亲。同类的血脉传承在世界上有些相当知名的例子，但绝大多数都相对隐蔽。每一位现世的术士都可能是一条新血脉的开创者，这可以来自一个契约，或来自某些特殊的环境因素影响。</p>","chat":""},"source":{"custom":"","book":"","page":"","license":"CC-BY-4.0","rules":"2014"},"identifier":"draconic-bloodline","classIdentifier":"sorcerer","advancement":[{"_id":"bjbipb2oydq3zsuy","type":"ItemGrant","configuration":{"items":[{"uuid":"Compendium.dnd5e.classfeatures.EZsonMThTNLZq35j","optional":false},{"uuid":"Compendium.dnd5e.classfeatures.MW1ExvBLm8Hg82aA","optional":false}],"optional":false,"spell":{"ability":[],"preparation":"","uses":{"max":"","per":""}}},"value":{},"level":1,"title":"子职业特性"},{"_id":"cq0cwgss39pkvjox","type":"ItemGrant","configuration":{"items":[{"uuid":"Compendium.dnd5e.classfeatures.x6eEZ9GUsuOcEa3G","optional":false}],"optional":false,"spell":{"ability":[],"preparation":"","uses":{"max":"","per":""}}},"value":{},"level":6,"title":"子职业特性"},{"_id":"rfd6o6858pl8k7fl","type":"ItemGrant","configuration":{"items":[{"uuid":"Compendium.dnd5e.classfeatures.3647zjKSE9zFwOXc","optional":false}],"optional":false,"spell":{"ability":[],"preparation":"","uses":{"max":"","per":""}}},"value":{},"level":14,"title":"子职业特性"},{"_id":"4xrl7vjblpn8zl5t","type":"ItemGrant","configuration":{"items":[{"uuid":"Compendium.dnd5e.classfeatures.Gsha4bl0apxqspFy","optional":false}],"optional":false,"spell":{"ability":[],"preparation":"","uses":{"max":"","per":""}}},"value":{},"level":18,"title":"子职业特性"},{"_id":"Gg8rCLE8zNfjpGOV","type":"Trait","configuration":{"mode":"default","allowReplacements":false,"grants":["languages:exotic:draconic"],"choices":[]},"level":1,"title":"","value":{"chosen":[]}}],"spellcasting":{"progression":"none","ability":"","preparation":{}}},"effects":[],"folder":"TCB42RLUb0HxUb2M","sort":0,"ownership":{"default":0},"flags":{"mtzh":{"s":"zzzz","m":"id"}},"_id":"2nadB2MBSHTQ0kcl","_stats":{"duplicateSource":null,"coreVersion":"13.344","systemId":"dnd5e","systemVersion":"