tats":{"systemId":"dnd5e","systemVersion":"3.1.0","coreVersion":"11.315","createdTime":1709764992288,"modifiedTime":1709764992288,"lastModifiedBy":"dnd5ebuilder0000"}},{"name":"侍僧特性 Acolyte Feature","sorting":"a","folder":null,"type":"Item","_id":"IDsMSIlTi30OcUmh","sort":0,"color":null,"flags":{"mtzh":{"s":"manual","m":"manual"}},"_stats":{"systemId":"dnd5e","systemVersion":"3.0.2","coreVersion":"11.315","createdTime":1707528588108,"modifiedTime":1707528588108,"lastModifiedBy":"dnd5ebuilder0000"}},{"folder":"HF9j5ChBAp5PTdjs","name":"钱袋 Coin Pouch","type":"container","_id":"dQaOdm9dbVN0RZYP","img":"icons/containers/bags/coinpouch-simple-leather-brown.webp","system":{"description":{"value":"","chat":""},"source":{"book":"","page":"61","custom":"","license":"CC-BY-4.0","rules":"2014"},"identified":true,"unidentified":{"description":""},"container":null,"quantity":1,"weight":{"value":0,"units":"lb"},"price":{"value":0,"denomination":"gp"},"rarity":"","attunement":"","equipped":false,"currency":{"pp":0,"gp":15,"ep":0,"sp":0,"cp":0},"properties":[],"capacity":{"type":"weight","value":null},"attuned":false,"identifier":"coin-pouch"},"effects":[],"sort":0,"ownership":{"default":0},"flags":{"mtzh":{"s":"zzzz","m":"id"}},"_stats":{"duplicateSource":null,"coreVersion":"13.344","systemId":"dnd5e","systemVersion":"4.0.0","createdTime":1725037368290,"modifiedTime":1725992238320,"lastModifiedBy":"dnd5ebuilder0000","exportSource":null}},{"name":"信徒庇护 Shelter of the Faithful","type":"feat","img":"icons/environment/settlement/gazebo.webp","system":{"description":{"value":"<p>作为侍僧，你能获得同信仰者的尊重，并且可以主持你神祇的宗教仪式。你和你的冒险伙伴可以期望在神殿、圣祠，或其他已建立的同信仰场所获得免费的治疗和照料，但你必须自行提供法术所需的材料成分。与你信奉同一宗教的人会以俭朴生活方式支持你，但仅限于你本人。</p><p>你也可能与一座供奉你所选神祇或神系的特定神殿有所联系，并且在那里拥有住所。如果你与过去侍奉的神殿仍保持良好关系，这里可以是你曾经服务的神殿；也可以是你后来找到的新归宿。当你处于自己神殿附近时，只要你请求的协助不涉及危险，并且你在神殿中仍有良好声誉，你就可以请求祭司们协助你。</p>","chat":""},"source":{"custom":"","book":"","page":"61","license":"CC-BY-4.0","rules":"2014"},"uses":{"max":"","spent":0,"recovery":[]},"type":{"value":"background","subtype":""},"requirements":"Acolyte","properties":["trait"],"activities":{},"enchant":{},"prerequisites":{"level":null},"identifier":"shelter-of-the-faithful"},"effects":[],"folder":"IDsMSIlTi30OcUmh","sort":100000,"ownership":{"default":0},"flags":{"mtzh":{"s":"zzzz","m":"id"}},"_id":"64N1NWh9kC1dI7zN","_stats":{"duplicateSource":null,"coreVersion":"13.344","systemId":"dnd5e","systemVersion":"4.0.0","createdTime":1725037368243,"modifiedTime":1725992238255,"lastModifiedBy":"dnd5ebuilder0000","exportSource":null}}]